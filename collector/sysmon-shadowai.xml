<!--
  Shadow AI 연구용 Sysmon 설정 (실험 VM 전용 출발점)
  설치: sysmon64.exe -accepteula -i sysmon-shadowai.xml   / 갱신: sysmon64.exe -c sysmon-shadowai.xml

  - EID 1  ProcessCreate        : AI 데스크톱 앱·로컬 LLM·다운로드 파일 실행
  - EID 3  NetworkConnect       : 브라우저/스크립트의 AI 도메인 연결
  - EID 11 FileCreate           : 다운로드·압축 파일 생성 (사용자 폴더)
  - EID 15 FileCreateStreamHash : Zone.Identifier(다운로드 출처 URL) — Contents 필드
  - EID 22 DNSQuery             : 프로세스별 DNS 질의
  - EID 24 ClipboardChange      : 클립보드 변경 (CaptureClipboard 필요, 내용은 ArchiveDirectory 에 보관)
  - EID 26 FileDeleteDetected   : 삭제 기록 (원본 보관 없는 EID 26 사용 — 디스크 사용량 고려)

  ⚠ EID 24 를 켜면 클립보드 원문이 ArchiveDirectory 에 저장된다. 운영 환경에서는 개인정보 영향평가 후
    대상 프로세스를 좁히거나 비활성화할 것. 운영 정책은 docs/research/04 참고.
  ⚠ schemaversion 은 설치한 Sysmon 버전에 맞출 것 (sysmon64 -s 로 확인).
-->
<Sysmon schemaversion="4.90">
  <HashAlgorithms>SHA256</HashAlgorithms>
  <CheckRevocation/>
  <DnsLookup>False</DnsLookup>
  <ArchiveDirectory>SysmonArchive</ArchiveDirectory>
  <CaptureClipboard/>
  <EventFiltering>
    <RuleGroup name="proc" groupRelation="or">
      <ProcessCreate onmatch="exclude">
        <Image condition="begin with">C:\Windows\System32\svchost.exe</Image>
      </ProcessCreate>
    </RuleGroup>
    <RuleGroup name="net" groupRelation="or">
      <NetworkConnect onmatch="include">
        <DestinationHostname condition="end with">chatgpt.com</DestinationHostname>
        <DestinationHostname condition="end with">openai.com</DestinationHostname>
        <DestinationHostname condition="end with">oaiusercontent.com</DestinationHostname>
        <DestinationHostname condition="end with">claude.ai</DestinationHostname>
        <DestinationHostname condition="end with">anthropic.com</DestinationHostname>
        <DestinationHostname condition="end with">gemini.google.com</DestinationHostname>
        <DestinationHostname condition="end with">googleapis.com</DestinationHostname>
        <DestinationHostname condition="end with">copilot.microsoft.com</DestinationHostname>
        <DestinationHostname condition="end with">perplexity.ai</DestinationHostname>
        <DestinationHostname condition="end with">deepseek.com</DestinationHostname>
        <DestinationHostname condition="end with">wrtn.ai</DestinationHostname>
        <DestinationPort condition="is">11434</DestinationPort> <!-- Ollama 로컬 API -->
        <DestinationPort condition="is">1234</DestinationPort>  <!-- LM Studio 로컬 서버 -->
      </NetworkConnect>
    </RuleGroup>
    <RuleGroup name="file" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename condition="contains">\Downloads\</TargetFilename>
        <TargetFilename condition="end with">.zip</TargetFilename>
        <TargetFilename condition="end with">.7z</TargetFilename>
        <TargetFilename condition="end with">.rar</TargetFilename>
        <TargetFilename condition="end with">.gguf</TargetFilename>
        <TargetFilename condition="end with">.safetensors</TargetFilename>
      </FileCreate>
      <FileCreateStreamHash onmatch="include">
        <TargetFilename condition="end with">Zone.Identifier</TargetFilename>
      </FileCreateStreamHash>
    </RuleGroup>
    <RuleGroup name="dns" groupRelation="or">
      <DnsQuery onmatch="exclude">
        <QueryName condition="end with">.arpa</QueryName>
      </DnsQuery>
    </RuleGroup>
    <RuleGroup name="clip" groupRelation="or">
      <ClipboardChange onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="del" groupRelation="or">
      <FileDeleteDetected onmatch="include">
        <TargetFilename condition="contains">\Users\</TargetFilename>
      </FileDeleteDetected>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
